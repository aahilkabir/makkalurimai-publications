---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8 flex items-baseline justify-between border-b border-border pb-4">
  <h2 class="font-serif text-2xl font-bold md:text-3xl">{title}</h2>
  {subtitle && <span class="text-sm text-muted-foreground">{subtitle}</span>}
</div>
