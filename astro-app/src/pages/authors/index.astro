---
import BaseLayout from '../../layouts/BaseLayout.astro';
import 'dotenv/config';
import { getAuthors } from '@makkalurimai/db';

const authors = await getAuthors();
---

<BaseLayout title="Authors">
  <section class="container py-12">
    <h1 class="font-serif text-3xl font-bold mb-8">Authors</h1>
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {authors.map((author) => (
        <a
          href={`/authors/${author.id}`}
          class="group flex flex-col items-center rounded-xl border border-border bg-card p-6 text-center shadow-sm transition-all hover:shadow-md hover:-translate-y-1"
        >
          <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-secondary text-xl font-serif font-bold text-accent group-hover:bg-accent/10 transition-colors">
            {author.name.charAt(0)}
          </div>
          <h3 class="font-serif text-lg font-bold">{author.name}</h3>
          <p class="text-sm text-muted-foreground">{author.books.length} Books</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
