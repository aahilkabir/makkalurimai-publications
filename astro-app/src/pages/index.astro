---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import 'dotenv/config';
import { getBooks, getFeaturedBooks, getCategories } from '@makkalurimai/db';

const [allBooks, featuredBooks, categories] = await Promise.all([
  getBooks(),
  getFeaturedBooks(),
  getCategories(),
]);

const heroBook = featuredBooks[0] || allBooks[0];
const newReleases = allBooks.slice(0, 8);
const bestSellers = [...allBooks].sort((a, b) => b.stock - a.stock).slice(0, 8);
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  {heroBook && (
    <section class="bg-secondary/30 py-16 md:py-24">
      <div class="container">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
          <div class="space-y-6">
            <span class="text-sm font-medium uppercase tracking-widest text-accent">Featured</span>
            <h1 class="font-serif text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
              {heroBook.title}
            </h1>
            <p class="text-lg text-muted-foreground">
              by {heroBook.author?.name || 'Unknown Author'}
            </p>
            <p class="text-muted-foreground leading-relaxed line-clamp-3">
              {heroBook.description || 'A captivating read waiting to be discovered.'}
            </p>
            <div class="flex gap-4 pt-4">
              <a
                href={`/books/${heroBook.slug}`}
                class="inline-flex items-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-transform hover:scale-105"
              >
                View Book
              </a>
              <a
                href="/books"
                class="inline-flex items-center rounded-lg border border-border px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-secondary"
              >
                Browse All
              </a>
            </div>
          </div>
          <div class="mx-auto aspect-[2/3] w-full max-w-sm overflow-hidden rounded-xl shadow-2xl rotate-2 transition-transform duration-500 hover:rotate-0 lg:max-w-md">
            <img
              src={heroBook.coverImage || `https://placehold.co/400x600/F9F5F1/1A1A2E?text=${encodeURIComponent(heroBook.title)}`}
              alt={heroBook.title}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- New Releases -->
  <section class="container py-16">
    <SectionHeader title="New Releases" subtitle="Recently added to our collection" />
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
      {newReleases.map((book) => (
        <BookCard
          title={book.title}
          author={book.author?.name || 'Unknown Author'}
          price={book.price}
          coverImage={book.coverImage}
          slug={book.slug}
          category={book.booksToCategories?.[0]?.category?.name}
        />
      ))}
    </div>
  </section>

  <!-- Category Discovery -->
  {categories.length > 0 && (
    <section class="bg-secondary/20 py-16">
      <div class="container">
        <SectionHeader title="Browse by Category" />
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
          {categories.map((cat) => (
            <a
              href={`/books/category/${cat.slug}`}
              class="group rounded-xl border border-border bg-card p-6 text-center transition-all hover:shadow-lg hover:-translate-y-1"
            >
              <h3 class="font-serif font-bold text-lg group-hover:text-accent transition-colors">{cat.name}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Best Sellers -->
  <section class="container py-16">
    <SectionHeader title="Best Sellers" subtitle="Most popular titles" />
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
      {bestSellers.map((book) => (
        <BookCard
          title={book.title}
          author={book.author?.name || 'Unknown Author'}
          price={book.price}
          coverImage={book.coverImage}
          slug={book.slug}
          category={book.booksToCategories?.[0]?.category?.name}
        />
      ))}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="bg-primary text-primary-foreground py-16">
    <div class="container text-center max-w-xl mx-auto space-y-4">
      <h2 class="font-serif text-3xl font-bold">Stay in the Loop</h2>
      <p class="text-primary-foreground/70">Get notified about new releases and literary recommendations.</p>
      <form class="flex gap-2 mt-6">
        <input
          type="email"
          placeholder="your@email.com"
          class="flex-1 rounded-lg border-0 bg-primary-foreground/10 px-4 py-3 text-sm text-primary-foreground placeholder:text-primary-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent"
        />
        <button type="submit" class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground transition-transform hover:scale-105">
          Subscribe
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
