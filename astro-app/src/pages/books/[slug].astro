---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import 'dotenv/config';
import { getBooks, getBookBySlug } from '@makkalurimai/db';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({
    params: { slug: book.slug },
  }));
}

const { slug } = Astro.params;
const book = await getBookBySlug(slug!);
if (!book) return Astro.redirect('/404');

// Related books: same category, exclude current
const allBooks = await getBooks();
const relatedBooks = allBooks
  .filter((b) =>
    b.id !== book.id &&
    b.booksToCategories.some((btc) =>
      book.booksToCategories.some((tgtBtc) => tgtBtc.categoryId === btc.categoryId)
    )
  )
  .slice(0, 4);

const displayPrice = `$${(book.price / 100).toFixed(2)}`;
const imgSrc = book.coverImage || `https://placehold.co/600x900/F9F5F1/1A1A2E?text=${encodeURIComponent(book.title)}`;
---

<BaseLayout title={book.title} description={book.description || undefined}>
  <div class="container py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <a href="/books" class="inline-flex items-center text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group">
        <span class="mr-2 transition-transform group-hover:-translate-x-1">←</span> Back to Bookstore
      </a>
    </nav>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Cover Image -->
      <div class="lg:col-span-5">
        <div class="sticky top-24">
          <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl bg-secondary shadow-2xl">
            <img
              src={imgSrc}
              alt={book.title}
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="flex flex-col justify-center lg:col-span-7">
        <div class="space-y-4 mb-8">
          <div class="flex flex-wrap gap-2">
            {book.booksToCategories.map((btc) => (
              <a
                href={`/books/category/${btc.category.slug}`}
                class="rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground hover:border-accent hover:text-accent transition-colors"
              >
                {btc.category.name}
              </a>
            ))}
          </div>
          <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            {book.title}
          </h1>
          <p class="text-lg text-muted-foreground">
            by <span class="font-medium text-foreground">{book.author?.name || 'Unknown Author'}</span>
          </p>
        </div>

        <div class="mb-10 text-muted-foreground leading-relaxed text-lg">
          <p>{book.description}</p>
        </div>

        <!-- Purchase Card -->
        <div class="rounded-xl border border-border bg-card p-8 shadow-sm mb-10">
          <div class="flex flex-col sm:flex-row items-baseline justify-between gap-4 border-b border-border pb-6 mb-6">
            <div>
              <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Price</p>
              <p class="font-serif text-4xl font-bold">{displayPrice}</p>
            </div>
            <div class="text-right">
              <p class="text-sm font-medium uppercase tracking-wider text-muted-foreground">Availability</p>
              <p class={`text-lg font-medium ${book.stock > 0 ? 'text-green-600' : 'text-destructive'}`}>
                {book.stock > 0 ? 'In Stock' : 'Out of Stock'}
              </p>
            </div>
          </div>

          <button
            class="w-full rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.02] disabled:opacity-50"
            disabled={book.stock === 0}
          >
            {book.stock > 0 ? `Add to Cart — ${displayPrice}` : 'Out of Stock'}
          </button>
          <p class="mt-3 text-center text-xs text-muted-foreground">
            Free shipping on orders over $50. Secure checkout via Stripe.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Books -->
    {relatedBooks.length > 0 && (
      <div class="mt-24 border-t border-border pt-16">
        <SectionHeader title="You Might Also Like" />
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
          {relatedBooks.map((b) => (
            <BookCard
              title={b.title}
              author={b.author?.name || 'Unknown Author'}
              price={b.price}
              coverImage={b.coverImage}
              slug={b.slug}
              category={b.booksToCategories?.[0]?.category?.name}
            />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
