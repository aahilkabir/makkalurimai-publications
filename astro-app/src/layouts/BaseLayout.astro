---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Discover curated collections of literature at Makkalurimai Publications.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <title>{title} | Makkalurimai Publications</title>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Navbar -->
  <header class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-md">
    <div class="container flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="text-xl font-serif font-bold text-foreground">Makkalurimai</span>
      </a>
      <nav class="hidden items-center gap-8 md:flex">
        <a href="/books" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Books</a>
        <a href="/authors" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Authors</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/books" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors md:hidden">Books</a>
        <a href="/authors" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors md:hidden">Authors</a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-border bg-secondary/30">
    <div class="container py-12">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div>
          <h3 class="font-serif text-lg font-bold mb-4">Makkalurimai Publications</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Curating exceptional literature for the discerning reader since 2024.
          </p>
        </div>
        <div>
          <h4 class="font-serif font-bold mb-4">Explore</h4>
          <ul class="space-y-2 text-sm text-muted-foreground">
            <li><a href="/books" class="hover:text-foreground transition-colors">All Books</a></li>
            <li><a href="/authors" class="hover:text-foreground transition-colors">Authors</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-serif font-bold mb-4">Stay Updated</h4>
          <p class="text-sm text-muted-foreground">Subscribe to our newsletter for new releases and literary discussions.</p>
        </div>
      </div>
      <div class="mt-12 border-t border-border pt-8 text-center text-xs text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Makkalurimai Publications. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
